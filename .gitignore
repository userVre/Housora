*.log
*.bak
screenshots/
mywebsitescreenshoots/

# Convex generated files and user uploads
convex/_generated/
uploads/
.wrangler/tmp/

# The runtime source of truth is Kotlin/Ktor. These folders are an untracked
# Next.js migration scratch tree and must not leak into the production build.
app/
components/
lib/
public/
middleware.ts
next.config.ts
next-env.d.ts
open-next.config.ts
convex/vitest.config.mts
functions/package.json

