{
  "name": "housora-ai",
  "version": "1.0.0",
  "private": true,
  "config": {
    "testPort": 8082
  },
  "scripts": {
    "build": "npm run assets:build && node build-site.js && npm run assets:publish && npm run assets:verify",
    "assets:build": "node scripts/build-assets.js",
    "assets:inventory": "node scripts/verify-assets.js --report-only",
    "assets:publish": "node scripts/publish-assets.js",
    "assets:verify": "node scripts/verify-assets.js",
    "build:jvm": "node gradle-runner.js build",
    "verify:build": "npm run build && npm run build:jvm",
    "start": "npm run assets:build && node gradle-runner.js run",
    "dev": "npx convex dev",
    "deploy": "npx convex deploy",
    "build:static": "npm run assets:build && node build-static.js && npm run assets:publish && npm run assets:verify",
    "test": "npm run test:unit && npm run test:kotlin",
    "test:unit": "vitest run --config convex/vitest.config.ts",
    "test:kotlin": "node gradle-runner.js test",
    "audit:dependencies": "node scripts/dependency-report.js",
    "audit:npm": "npm audit",
    "audit:npm:production": "npm audit --omit=dev",
    "audit:routes": "node scripts/site-audit-runner.js route-crawler.js",
    "audit:seo": "node scripts/seo-crawler.js",
    "audit:links": "node scripts/site-audit-runner.js route-crawler.js",
    "audit:assets": "node scripts/site-audit-runner.js scripts/verify-assets.js",
    "audit:a11y": "node scripts/site-audit-runner.js scripts/accessibility-smoke.js",
    "audit:site": "npm run audit:routes && npm run audit:a11y",
    "deploy:pages": "npm run assets:verify && npx wrangler pages deploy dist"
  },
  "dependencies": {
    "convex": "^1.43.0",
    "posthog-node": "5.46.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/clerk-js": "6.25.7",
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.55",
    "playwright": "^1.61.1",
    "posthog-js": "1.407.3",
    "sharp": "0.34.3",
    "vitest": "^4.1.10"
  }
}
