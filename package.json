{
  "name": "housora-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.22.0"
  },
  "config": {
    "testPort": 8082
  },
  "scripts": {
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "typecheck": "tsc --noEmit",
    "next:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "next:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "assets:build": "node scripts/build-assets.js",
    "assets:inventory": "node scripts/verify-assets.js --report-only",
    "assets:publish": "node scripts/publish-assets.js",
    "assets:verify": "node scripts/verify-assets.js",
    "build:jvm": "node gradle-runner.js build",
    "build": "bun run build:static",
    "verify:build": "bun run build && bun run build:jvm",
    "start": "bun run assets:build && node gradle-runner.js run",
    "dev": "bunx convex dev",
    "deploy": "bunx convex deploy",
    "build:static": "bun run assets:build && node build-site.js && bun run assets:publish && bun run assets:verify",
    "test": "bun run test:unit && bun run test:kotlin",
    "test:unit": "vitest run --config convex/vitest.config.mts",
    "test:kotlin": "node gradle-runner.js test",
    "audit:dependencies": "node scripts/dependency-report.js",
    "audit:npm": "npm audit",
    "audit:npm:production": "npm audit --omit=dev",
    "audit:routes": "node scripts/site-audit-runner.js route-crawler.js",
    "audit:seo": "node scripts/seo-crawler.js",
    "audit:links": "node scripts/site-audit-runner.js route-crawler.js",
    "audit:assets": "node scripts/site-audit-runner.js scripts/verify-assets.js",
    "audit:a11y": "node scripts/site-audit-runner.js scripts/accessibility-smoke.js",
    "audit:i18n": "node scripts/site-audit-runner.js scripts/i18n-smoke.js",
    "audit:site": "bun run audit:routes && bun run audit:a11y && bun run audit:i18n",
    "audit:duplicates": "node scripts/duplicate-rendering-audit.js",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "convex": "1.44.0",
    "posthog-node": "5.46.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@edge-runtime/vm": "^5.0.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "convex-test": "^0.0.55",
    "detect-libc": "2.1.2",
    "playwright": "^1.61.1",
    "posthog-js": "1.417.1",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  }
}
