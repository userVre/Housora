{
  "name": "housora-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "config": {
    "testPort": 8082
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "assets:build": "node scripts/build-assets.js",
    "assets:inventory": "node scripts/verify-assets.js --report-only",
    "assets:publish": "node scripts/publish-assets.js",
    "assets:verify": "node scripts/verify-assets.js",
    "verify:build": "npm run typecheck && npm run build",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "build:static": "npm run assets:build && node build-static.js && npm run assets:publish && npm run assets:verify",
    "test": "npm run test:unit && npm run test:edge",
    "test:unit": "vitest run --config convex/vitest.config.mts",
    "test:edge": "node functions/tests/security.test.mjs",
    "audit:dependencies": "node scripts/dependency-report.js",
    "audit:npm": "npm audit",
    "audit:npm:production": "npm audit --omit=dev",
    "audit:routes": "node scripts/site-audit-runner.js route-crawler.js",
    "audit:seo": "node scripts/seo-crawler.js",
    "audit:links": "node scripts/site-audit-runner.js route-crawler.js",
    "audit:assets": "node scripts/site-audit-runner.js scripts/verify-assets.js",
    "audit:a11y": "node scripts/site-audit-runner.js scripts/accessibility-smoke.js",
    "audit:i18n": "node scripts/site-audit-runner.js scripts/i18n-smoke.js",
    "audit:site": "npm run audit:routes && npm run audit:a11y && npm run audit:i18n",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@clerk/nextjs": "7.7.6",
    "convex": "^1.43.0",
    "next": "16.3.1",
    "posthog-js": "1.417.1",
    "posthog-node": "5.46.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@edge-runtime/vm": "^5.0.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "convex-test": "^0.0.55",
    "playwright": "^1.61.1",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  }
}
